+// userNamespacesRestricted reports whether AppArmor blocks unprivileged user
+// namespaces (Ubuntu 24.04+ default: kernel.apparmor_restrict_unprivileged_userns=1).
+// nsjail then fails with "mount('/', '/', ...): Permission denied", so shac
+// falls back to genericSandbox, as it does when /proc is read-only.
+func userNamespacesRestricted(sysctlPath string) bool {
+	//#nosec G304
+	b, err := os.ReadFile(sysctlPath)
+	return err == nil && strings.TrimSpace(string(b)) == "1"
+}
+
