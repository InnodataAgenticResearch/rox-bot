[Unit]
Description=Rox-Bot (Custom ArtBOT) GCP Ops & Security Lead Microsoft Teams Channel Bridge
After=network-online.target hermes-gateway.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/rox-bot
EnvironmentFile=%h/.hermes/profiles/rox-bot/.env
Environment=PYTHONPATH=%h/rox-bot/src:%h/artbot/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m rox_bot.cli fleet-audit
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=roxbot-teams-bridge

[Install]
WantedBy=default.target
